title: CryoSPARC
cluster: "phoenix-dev"
attributes:
  license_id:
    id: license_id
    label: "CryoSPARC License ID"
    widget: text_field
  work_dir:
    id: work_dir
    label: "CryoSPARC Working Directory"
    widget: text_field
    help: |
      Used to store CryoSPARC database and session files.

      Can be an empty directory (for a new session) or a directory from a previous
      CryoSPARC OOD session (to re-use previous session).
  # TODO: On dev cluster, path_selector is spinning endlessly
  # work_dir:
  #   id: work_dir
  #   label: "CryoSPARC Working Directory"
  #   widget: path_selector
  #   show_hidden: false
  #   show_files: false
  #   favorites:
  #     - "<%= CurrentUser.home %>"
  bc_vnc_resolution:
    required: true
  bc_account:
    label: "Charge Account"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options: 
      - ["embers"]
      - ["inferno"]
    value: "inferno"
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['NVIDIA GPU V100 16GB', 'V100_16GB']
      - ['NVIDIA GPU RTX6000', 'RTX_6000']
      - ['First available', 'first_avail']
  num_cpus:
    id: num_cpus
    label: "Number of CPUs"
    widget: number_field
    min: 1
    step: 1
    value: 1
  num_gpus:
    id: num_gpus
    label: "Number of GPUs"
    widget: number_field
    min: 1
    step: 1
    value: 1
  num_mem:
    id: num_mem
    label: "Total Memory (GB)"
    widget: number_field
    min: 16 
    step: 1
    value: 16

form:
- license_id
- work_dir
- bc_vnc_resolution
- bc_account
- qos
- node_type
- num_cpus
- num_gpus
- num_mem