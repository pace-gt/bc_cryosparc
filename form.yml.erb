title: "CryoSPARC (RHEL9)"
cluster: "phoenix-rh9"
attributes:
  license_id:
    id: license_id
    label: "CryoSPARC License ID"
    widget: password_field
    help: |
      The alpha-numeric license ID that you receive when you sign-up for
      CryoSPARC.  To sign-up and receive a license ID, go to
      https://cryosparc.com/download and complete the form.  
  work_dir:
    id: work_dir
    label: "CryoSPARC Session Directory"
    widget: text_field
    help: |
      Used to store CryoSPARC database and session files.

      This can be an empty directory (for a new session) or a directory from a
      previous CryoSPARC OOD session (to re-use previous session). Re-using a
      previous session directory will retain all your job history  from the
      previous session, and this is encouraged.
  # TODO: On dev cluster, path_selector is spinning endlessly
  # work_dir:
  #   id: work_dir
  #   label: "CryoSPARC Working Directory"
  #   widget: path_selector
  #   show_hidden: false
  #   show_files: false
  #   favorites:
  #     - "<%= CurrentUser.home %>"
  bc_vnc_resolution:
    required: true
  bc_account:
    label: "Charge Account"
    help: "Required.  Has the format: `gts-<PI username>`"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"
    help: |
      Determines the priority of this job and whether your job incurs account charges. See our [QOS guide](https://gatech.service-now.com/home?id=kb_article_view&sysparm_article=KB0041998#qos-on-the-phoenix-slurm-cluster) for full info. 
      
      * inferno: Jobs have normal priority are charged to your account.  
      * embers:  Jobs are not charged to your account but have lower priority.   
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['NVIDIA GPU A100 40GB', 'A100_40GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 515,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU A100 80GB', 'A100_80GB',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 2051,
          data-max-bc-num-hours: 504
        ]
      - ["NVIDIA GPU H100 HGX (64-core CPU)", "H100_HGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 2063,
          data-max-bc-num-hours: 72
        ]
      - ["NVIDIA GPU H100 DGX (112-core CPU)", "H100_DGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 112,
          data-max-num-mem-per-core: 2063,
          data-max-bc-num-hours: 72
        ]
      - ['NVIDIA GPU RTX6000', 'RTX_6000',
          data-max-num-gpus: 4,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 16GB', 'V100_16GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 32GB', 'V100_32GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU L40S', 'L40S',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 32,
          data-max-num-mem-per-core: 515,
          data-max-bc-num-hours: 72
        ]
    help: |
      Hardware specs for all node types are listed [here](https://gatech.service-now.com/technology?id=kb_article_view&sysparm_article=KB0041976).
  bc_num_slots: 1
  num_cores:
    widget: number_field
    label: "Cores Per Node"
    # Max and val set properly using dynamic web forms
    min: 1
    step: 1
    value: 4
    help: |
      Number of cores (or "CPUs") reserved per node.  
      
      Multiple cores can be used for either multi-process or multi-threaded programs.  Many multi-threaded Python programs (like PyTorch and TensorFlow) are intended to run with 1 node and multiple cores-per-node.  Jupyter itself may also be more responsive with ≥ 4 cores.  
  num_mem_per_core:
    widget: number_field
    label: "Memory Per Core (GB)"
    min: 1
    step: 1
    value: 8
    help: |
      The total memory for the job is: nodes × cores-per-node × memory-per-core.  The desktop itself may be more responsive with ≥ 16 GB total memory.
  num_gpus:
    label: "GPUs Per Node"
    widget: number_field
    # Min, max, and val set properly using dynamic web forms
    min: 0
    step: 1
    value: 0
    help: |
      Number of GPUs reseserved per node.  
    
      On a given node, all your job's cores can access the reserved GPUs on that node.
  bc_num_hours:
    help: |
      Your job will terminate after this time limit.  
      
      * Jobs with shorter time limits are typically scheduled sooner.
      * Your job will keep running even if you close your browser or lose your internet connection.  You can then re-connect to the same session later, if the time limit has not expired.  
      * Your account will be charged while your job is running (even if it is not open in your browser).  If you are done with your work before your time expires, you can cancel the job and avoid being charged for unused time.  

form:
- license_id
- work_dir
- bc_vnc_resolution
- bc_account
- qos
- node_type
- num_cores
- num_gpus
- num_mem_per_core
- bc_num_hours
- bc_email_on_started
