title: "CryoSPARC (RHEL9)"
cluster: "phoenix-rh9"
attributes:
  license_id:
    id: license_id
    label: "CryoSPARC License ID"
    widget: password_field
    help: |
      The alpha-numeric license ID that you receive when you sign-up for
      CryoSPARC.  To receive a license ID, go to
      https://cryosparc.com/download and complete the form.  
  work_dir:
    widget: path_selector
    label: "CryoSPARC Session Directory"
    directory: "<%= CurrentUser.home %>"
    required: true
    show_hidden: false
    show_files: false
    favorites:
      - "<%= CurrentUser.home %>"
      - "<%= CurrentUser.home %>/project"
    help: |
      Used to store CryoSPARC database and session files.

      This can be an empty directory (for a new session) or a directory from a
      previous CryoSPARC OOD session (to resume a previous session). Re-using a
      session directory will retain your work history and is encouraged.
  bc_vnc_resolution:
    required: true
  bc_account:
    label: "Charge Account"
    help: "Required.  Has the format: `gts-<PI username>`"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"
    help: |
      Determines the priority of this job and whether your job incurs account charges. See our [QOS guide](https://gatech.service-now.com/home?id=kb_article_view&sysparm_article=KB0041998#qos-on-the-phoenix-slurm-cluster) for full info. 
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['NVIDIA GPU A100 40GB', 'A100_40GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem: 515,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU A100 80GB', 'A100_80GB',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem: 2051,
          data-max-bc-num-hours: 504
        ]
      - ["NVIDIA GPU H100 HGX (64-core CPU)", "H100_HGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 64,
          data-max-num-mem: 2063,
          data-max-bc-num-hours: 72
        ]
      - ["NVIDIA GPU H100 DGX (112-core CPU)", "H100_DGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 112,
          data-max-num-mem: 2063,
          data-max-bc-num-hours: 72
        ]
      - ['NVIDIA GPU RTX6000', 'RTX_6000',
          data-max-num-gpus: 4,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 16GB', 'V100_16GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 32GB', 'V100_32GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-num-cores: 24,
          data-max-num-mem: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU L40S', 'L40S',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-num-cores: 32,
          data-max-num-mem: 515,
          data-max-bc-num-hours: 72
        ]
    help: |
      Hardware specs for all node types are listed [here](https://gatech.service-now.com/technology?id=kb_article_view&sysparm_article=KB0041976).
  bc_num_slots: 1
  num_cores:
    widget: number_field
    label: "Number of cores (CPUs)"
    # Max and val set properly using dynamic web forms
    min: 4
    step: 1
    value: 4
  num_mem:
    widget: number_field
    label: "Memory (GB)"
    min: 64
    step: 1
    value: 64
  num_gpus:
    label: "Number of GPUs"
    widget: number_field
    # Min, max, and val set properly using dynamic web forms
    min: 1
    step: 1
    value: 0
  bc_num_hours:
    help: |
      Your job will terminate after this time limit.  
      
      * Jobs with shorter time limits are typically scheduled sooner.
      * Your job will keep running even if you close your browser or lose your internet connection.  You can then re-connect to the same session later, if the time limit has not expired.  
      * Your account will be charged while your job is running (even if it is not open in your browser).  If you are done with your work before your time expires, you can cancel the job and avoid being charged for unused time.  

form:
- license_id
- work_dir
- bc_vnc_resolution
- bc_account
- qos
- node_type
- num_cores
- num_gpus
- num_mem
- bc_num_hours
- bc_email_on_started
